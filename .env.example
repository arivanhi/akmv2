# Konfigurasi Database PostgreSQL (web menggunakan network_mode: host -> 127.0.0.1:5433)
DB_NAME=health_monitoring_db
DB_USER=admin
DB_PASSWORD=akmv2_udinus_password
DB_HOST=127.0.0.1
DB_PORT=5433

# Kunci Rahasia untuk Sesi Flask
SECRET_KEY=akmv2_kopersakti_udinus_secret_key_2026

# Broker MQTT Lokal (Container mosquitto di port 1883)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Bus I2C Sensor Kopersakti (Raspberry Pi /dev/i2c-1)
I2C_BUS_NUM=1

# MAC Address Default Tensimeter BLE Omron HEM-7156T
BLE_OMRON_MAC=00:5F:BF:E2:25:DC

# Konfigurasi Integrasi API Dinas Kesehatan
ID_KOPER=koper_01
KOTA_DEFAULT=Semarang
EXTERNAL_API_URL=
API_KEY_DINKES=
